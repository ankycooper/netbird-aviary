# Copy to .env and fill in. Do NOT commit .env (it's in .gitignore).

# NetBird Personal Access Token — required.
# Create one at NetBird UI -> User -> API tokens. Starts with `nbp_`.
NETBIRD_API_TOKEN=nbp_replace_me

# NetBird Setup Key — required only for target_mode=network (embedded agent).
# Create at NetBird UI -> Setup Keys. UUID format. Use a reusable key with a
# short expiry; the controller uses it once on first run, then the wireguard
# private key in the /etc/netbird volume takes over.
NETBIRD_SETUP_KEY=

# Per-service secrets referenced from docker-compose.yml labels.
# Add your own as needed; the controller passes label values through verbatim.
MULTI_WEB_PASSWORD=changeme
MULTI_API_HEADER_KEY=changeme
